{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File harness/hooks/session-start.ps1"
      }
    ],
    "postToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File harness/hooks/post-edit-remind.ps1",
        "matcher": "Write|Edit|Shell"
      }
    ]
  }
}
