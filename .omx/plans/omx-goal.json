  "_使用说明": {
    "激活": "复制此文件到 .omx/plans/active/<goal_id>.json，填写 goal_definition 字段后开始执行。",
    "执行模式": "aggregate（聚合模式）：每次会话深入完成一个目标；per-story（单故事模式）：每次会话处理一个独立用户故事。",
    "活跃上限": "活跃目标不超过 5 个。超过上限时需暂停或完成已有目标后再激活新目标。",
    "ledger 规则": "ledger 数组仅追加，不修改历史条目。每条记录格式：{timestamp, operation_type, description, affected_goal, result, evidence}。",
    "阶段切换": "当前阶段完成时将其 status 改为 'completed'；下一阶段改为 'in_progress'。",
    "OMX 记忆": "RECORD 和 HANDOFF 阶段必须将关键发现和决策写入 OMX 记忆，确保跨会话上下文连续。",
    "与其他技能的协作": "目标执行过程中可调用 $autoresearch（研究）、$executor（实现）、$code-review（审查）、$qa-testing（验证）等工作流技能。"
  }
