  ],
  "promotion_rules": [
    {
      "id": "methodology-repeat-to-procedural",
      "from_slot_type": "methodology",
      "to_slot_type": "procedural",
      "trigger": "same_lesson_observed_three_times",
      "required_evidence": [
        "project_status_ledger_ref",
        "methodology_ref",
        "verification_result"
      ]
    },
    {
      "id": "episodic-completion-to-methodology",
      "from_slot_type": "episodic",
      "to_slot_type": "methodology",
      "trigger": "feature_done_or_three_related_files_changed",
      "required_evidence": [
        "changed_files",
        "test_evidence",
        "residual_risk"
      ]
    },
    {
      "id": "reference-deep-read-to-semantic",
      "from_slot_type": "reference",
      "to_slot_type": "semantic",
      "trigger": "source_changes_architecture_or_product_plan",
      "required_evidence": [
        "source_id",
        "dedupe_group",
        "decision_or_adr_ref"
      ]
    }
  ],
  "retrieval_policy": {
    "source_index_required": true,
    "default_query_slots": [
      "procedural",
      "methodology",
      "task_step"
    ],
    "graph_recall": {
      "enabled": true,
      "max_hops": 1,
      "edge_kinds": [
        "promotes_to",
        "depends_on",
        "evidenced_by",
        "dedupes_with"
      ]
    },
    "cold_path_triggers": [
      "architecture_update",
      "fact_conflict",
      "phase_transition",
      "skill_or_worker_change",
      "security_or_real_execution_gate",
      "audit_or_self_check_failure",
      "user_requested_research"
    ]
  },
  "lifecycle_policy": {
    "refresh_indexes": [
      "harness/methodology-memory-index.json",
      "harness/work-reports-index.json",
      "harness/sync-coherence-index.json",
      "harness/verification-snapshot-index.json",
      "harness/closure-gate-index.json"
    ],
    "promotion_count_threshold": 3,
    "staleness_hours": {
      "task_step": 24,
      "worker": 24,
      "skill_telemetry": 72,
      "reference": 720
    },
    "completion_requires": [
      "truth_source_update",
      "verification_evidence",
      "clean_worktree"
    ]
  }
}
