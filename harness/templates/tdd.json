  "_使用说明": {
    "激活": "将此模板的内容复制到 workflow-state.json 的 active_workflow 下，填写 context 字段后开始执行。",
    "Brainstorming": "BRAINSTORMING 阶段探索需求的多角度场景，填写 interface_contract（接口契约）和 test_scenarios（正面/负面/边界场景）。",
    "RED 阶段": "RED 阶段只写测试，不写实现代码。运行测试确认全部失败后，在 red_green_log 中记录测试名称和失败输出。",
    "GREEN 阶段": "GREEN 阶段写最小实现代码使测试通过。每次测试通过后记录到 red_green_log。",
    "REFACTOR 阶段": "REFACTOR 阶段在测试全部通过的前提下重构代码。重构前后运行测试确认无回归。记录到 refactor_log。",
    "门禁引用": "G-TDD-06 引用 G-STD-05，G-TDD-07 引用 G-STD-06。检查时对照 workflow-gates.md 中的原始定义。",
    "覆盖率": "coverage_target 默认 80%，可在 GREEN 阶段后运行覆盖率工具，填写 coverage_report 记录实际覆盖率。",
    "阶段切换": "当前阶段完成时，将其 status 改为 'completed'，填写 completed_at；将下一阶段 status 改为 'in_progress'。",
    "证据记录": "每次门禁检查和验证完成后，在 evidence_log 中追加一条记录，包含 gate_id、result、timestamp、verifier、details。"
  }
